        "show": [
          "de-bremen",
          "de-lower-saxony"
        ]
      },
      {
        "id": "split",
        "label": "Lower Saxony split (west / east around Bremen)",
        "show": [
          "de-bremen",
          "de-lower-saxony-west",
          "de-lower-saxony-east"
        ],
        "note": "West = Weser-Ems (Oldenburg/Cloppenburg/East Frisia, urban core Oldenburg); East = Braunschweig+Hannover+Lüneburg, urban core Hannover."
      },
      {
        "id": "united",
        "label": "Lower Saxony united (Bremen enclave absorbed)",
        "show": [
          "de-lower-saxony-bremen-united"
        ],
        "note": "Reflects Bremen's historical origin as a Lower-Saxon Hanseatic city and its complete geographic enclosure by Lower Saxony; the default map keeps Bremen as its own sovereign city-state Land."
      },
      {
        "id": "overlap",
        "label": "Overlapping claims",
        "show": [
          "de-bremen",
          "de-lower-saxony-bremen-united"
        ],
        "overlap": true,
        "note": "Demonstrates Bremen's enclave status within Lower Saxony's territory. This variant set merges the plan's separately named 'lower-saxony' and 'bremen' mandates into one set (4 views) because both would otherwise toggle visibility on the same underlying de-lower-saxony/de-bremen records, producing conflicting view states if kept as two independent sets -- documented in zone1.json's notes."
      }
    ]
  },
